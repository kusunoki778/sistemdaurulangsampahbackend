APP_NAME=Livora
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# Aiven mewajibkan SSL. Simpan CA di database/certs/aiven-mysql-ca.pem.
# Path native Render: /opt/render/project/src/database/certs/aiven-mysql-ca.pem
# Path Docker: /app/database/certs/aiven-mysql-ca.pem
# MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Produksi Render ---
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://livora-backend-txpl.onrender.com
# LOG_CHANNEL=stderr
# LOG_LEVEL=error
# TRUSTED_PROXIES=*
# CORS_ALLOWED_ORIGINS=https://sistemdaurulangsampahweb.vercel.app
# FRONTEND_URL=https://sistemdaurulangsampahweb.vercel.app
# Masa berlaku token login (menit). Default 7 hari:
# SANCTUM_EXPIRATION_MINUTES=10080

# --- Cloudinary (upload gambar admin) ---
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER_SAMPAH=livora/jenis-sampah
# CLOUDINARY_FOLDER_REWARD=livora/rewards
# CLOUDINARY_FOLDER_ARTIKEL=livora/artikels
# CLOUDINARY_FOLDER_AVATAR=livora/avatar

# --- Gemini (chatbot) ---
GEMINI_API_KEY=

# --- Login Google via Firebase Auth ---
# Web Client ID dari Firebase Console > Authentication > Google.
# GOOGLE_CLIENT_ID=

# --- Notifikasi HP (FCM HTTP v1) ---
# Isi dengan PATH berkas JSON, bukan isi JSON-nya. Jangan commit JSON-nya.
# Lokal: path relatif dari root backend.
# FCM_SERVICE_ACCOUNT_JSON=storage/app/firebase/fcm-service-account.json
# Render: upload JSON sebagai Secret File bernama fcm-service-account.json,
# lalu isi path absolut berikut.
# FCM_SERVICE_ACCOUNT_JSON=/etc/secrets/fcm-service-account.json

# --- Payout Xendit (pencairan koin ke e-wallet) ---
# Kosong berarti payout nyata ditolak. Untuk demo tanpa Xendit, set
# SANDBOX_PAYOUT=true. Jangan aktifkan di produksi sungguhan.
# XENDIT_SECRET_KEY=
# XENDIT_CALLBACK_TOKEN=
# XENDIT_API_VERSION=2025-09-01
# XENDIT_SOURCE_OF_FUND=BUSINESS_REVENUE
# XENDIT_PURPOSE_CODE=OTHER
# XENDIT_MINIMUM_RUPIAH=10000
# SANDBOX_PAYOUT=false

# --- Cloudflare Turnstile (login admin) ---
# Selama secret kosong, login admin memakai captcha aritmetika lokal.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
# TURNSTILE_TIMEOUT=8

VITE_APP_NAME="${APP_NAME}"
